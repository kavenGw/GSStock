@echo off
REM SSH tunnel to cloud server (see docs/superpowers/specs/2026-07-21-private-access-ssh-tunnel-design.md)
REM Usage:
REM   1. Copy this file to tunnel-9090.bat (gitignored, NEVER commit it), keeping the
REM      copy in this same scripts/ folder next to wait_and_open.ps1 (it is located via
REM      %~dp0, so a copy elsewhere silently loses the auto-open-browser behavior)
REM   2. Fill in the three values below
REM   3. One-time in WSL Ubuntu: sudo apt install sshpass
REM   4. Double-click tunnel-9090.bat; the browser opens http://127.0.0.1:9090/ by itself
REM      once the tunnel is up. Keep the window open -- closing it drops the tunnel.
REM Note: the password is handed to WSL via the SSHPASS env var, NOT the command line --
REM       wsl.exe expands $VAR in the command line it forwards, which silently truncates
REM       passwords containing $ . Still avoid " % and ^ (consumed by batch itself).
REM Note: if "wsl -d Ubuntu" fails, run "wsl -l" to confirm the distro name

set SERVER_USER=your_user
set SERVER_HOST=your.server.ip
set "SSHPASS=your_password"

REM Port 9090 must be free -- otherwise ssh -L fails to bind while the browser
REM still opens and points at whatever else is listening there.
netstat -ano | findstr /R /C:":9090 .*LISTENING" >nul
if %errorlevel% equ 0 (
    echo [ERROR] Local port 9090 is already in use -- another service
    echo         or an earlier tunnel window is still running.
    echo         Run "netstat -ano | findstr :9090" to find the owning PID.
    pause
    exit /b 1
)

start "" /min powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%~dp0wait_and_open.ps1" -Url "http://127.0.0.1:9090/"

set WSLENV=SSHPASS
set SSH_OPTS=-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes

REM Retry loop: ssh -N prints nothing on success, so echo before each attempt.
REM ConnectTimeout=10 surfaces an unreachable host in ~10s instead of the ~2 min
REM TCP default. Press Ctrl+C to stop the tunnel.
:connect
echo [%time:~0,8%] Connecting to %SERVER_USER%@%SERVER_HOST% (port 9090 -^> 127.0.0.1:9090) ...
wsl -d Ubuntu sshpass -e ssh -N %SSH_OPTS% -L 127.0.0.1:9090:127.0.0.1:9090 %SERVER_USER%@%SERVER_HOST%
echo [%time:~0,8%] ssh exited with code %errorlevel%, reconnecting in 5s (Ctrl+C to quit)
timeout /t 5 /nobreak >nul
goto connect
